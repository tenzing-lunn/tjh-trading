# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Data — keep the code, not the (re)generatable datasets
# Comment a line out if you DO want to share that data with the team
realdata/
realdata_archive_97/
# research_data/ is vendor data (Ken French extracts, Tiingo point-in-time prices) and stays
# out -- EXCEPT the point-in-time S&P 500 membership table, which is built from MIT
# (fja05680/sp500) + CC-BY-SA (Wikipedia) sources and is ours to commit. A blanket
# `research_data/` ignore prunes the whole directory from git's traversal, so a bare
# `!research_data/universe/membership.csv` would NOT work: each level has to be re-opened
# first (`dir/*` + `!dir/subdir/`) before a file negation can bite.
research_data/*
!research_data/universe/
research_data/universe/*
!research_data/universe/membership.csv
!research_data/universe/renames.csv
*.kronos.csv
spy.csv
qqq.csv
iwm.csv

# Web-app exports — regenerate with `python3 export_results.py [csv]`.
# Real-ticker exports embed Yahoo price series (redistribution-restricted), so
# they stay local. The synthetic export is public-safe and can be force-added
# later when the web app needs a bundled demo (git add -f exports/synthetic.results.json).
exports/

# Live-fetched ticker cache (yfinance writes here) — vendor data, regenerate on demand.
data_cache/

# Alpaca SIP 1-minute bars (plan/14 I1.1) — vendor data, regenerate with fetch_intraday.py.
intraday/

# Per-machine Claude Code permission allowlist (keep launch.json, drop the local one).
.claude/settings.local.json

# OS / editor junk
.DS_Store
.obsidian/
*.swp
