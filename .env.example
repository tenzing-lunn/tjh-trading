# Copy to .env (which is gitignored) and fill in your PAPER keys from the Alpaca dashboard.
# These are PAPER keys -- generated under the paper-trading account, not live.
# These are the keys Tenzing uses to run the shared paper account.
APCA_API_KEY_ID=your_paper_key_id_here
APCA_API_SECRET_KEY=your_paper_secret_here
# Paper endpoint. Do NOT change this to the live URL.
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Free Tiingo account (tiingo.com) -- delisted-stock price history for the P1.4
# no-hindsight universe (Yahoo has zero delisted-stock coverage). Free tier only.
TIINGO_API_KEY=your_tiingo_free_api_key_here
